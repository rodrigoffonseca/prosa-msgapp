# Copie para .env e ajuste. Veja docs/auto-hospedagem.md.

# "development" ou "production". Em produção, o servidor recusa configurações inseguras.
PROSA_ENV=production

# Segredo para o HMAC dos telefones (64 caracteres hex). Gere com: openssl rand -hex 32
# Guarde em local seguro: se for perdido, ninguém consegue mais entrar na conta pelo número.
PROSA_PHONE_PEPPER=

POSTGRES_PASSWORD=troque-esta-senha

# Envio de SMS: "webhook" chama um serviço HTTP seu, que fala com o provedor de SMS.
PROSA_SMS_PROVIDER=webhook
PROSA_SMS_WEBHOOK_URL=
PROSA_SMS_WEBHOOK_KEY=

# Ative apenas atrás de um proxy reverso confiável (Caddy, Nginx...).
PROSA_TRUST_PROXY_HEADERS=true

# Dias que mensagens não entregues e anexos ficam no servidor.
PROSA_RETENTION_DAYS=30
